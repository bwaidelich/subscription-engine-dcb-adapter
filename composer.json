{
    "name": "wwwision/subscription-engine-dcb-adapter",
    "description": "wwwision/dcb-eventstore adapter for wwwision/subscription-engine",
    "type": "package",
    "license": "MIT",
    "authors": [
        {
            "name": "Bastian Waidelich",
            "email": "b.waidelich@wwwision.de"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/bwaidelich"
        },
        {
            "type": "paypal",
            "url": "https://www.paypal.me/bwaidelich"
        }
    ],
    "require": {
        "php": ">=8.3",
        "wwwision/dcb-eventstore": "^5",
        "wwwision/subscription-engine": "^2"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpstan/phpstan": "^2",
        "squizlabs/php_codesniffer": "^4.0.x-dev",
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "Wwwision\\SubscriptionEngineDcbAdapter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wwwision\\SubscriptionEngineDcbAdapter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:phpstan": "phpstan",
        "test:cs": "phpcs --colors src",
        "test:cs:fix": "phpcbf --colors src",
        "test:phpunit": "phpunit",
        "test": [
            "@test:phpstan",
            "@test:cs",
            "@test:phpunit"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
